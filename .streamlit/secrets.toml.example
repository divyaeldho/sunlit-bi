# Copy this file to .streamlit/secrets.toml and fill in the values.
# NEVER commit secrets.toml to GitHub (it is in .gitignore).

APP_PASSWORD = "choose-a-dashboard-password"     # management: every page


# ---- AI (pick one) --------------------------------------------------------
AI_PROVIDER = "gemini"            # "gemini" (free tier) or "anthropic"
GEMINI_API_KEY = ""               # https://aistudio.google.com/apikey
ANTHROPIC_API_KEY = ""            # https://console.anthropic.com
# AI_MODEL = "gemini-2.5-flash"   # optional override

# ---- Email for brief_job.py (local runs) ----------------------------------
SMTP_USER = "you@gmail.com"
SMTP_APP_PASSWORD = ""            # Google Account → Security → App passwords
BRIEF_TO = "robin@example.com,divya@example.com"
DASHBOARD_URL = "https://sunlit-bi.streamlit.app"

# Extra passwords that open only some pages (pages per role: ROLES in core/config.py)
[ROLE_PASSWORDS]
finance = "choose-a-finance-password"           # Finance Dashboard, Cash Flow Monitor, Receivables

# ---- Google service account (paste the fields from the downloaded JSON) ----
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "sunlit-bi@your-project.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
